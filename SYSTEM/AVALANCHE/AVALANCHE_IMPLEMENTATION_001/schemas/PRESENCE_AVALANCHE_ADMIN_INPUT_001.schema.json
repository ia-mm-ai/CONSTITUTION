{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presence:avalanche:admin-input:1",
  "title": "Deployment-specific administrative input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "genesis_id",
    "locality_id",
    "purpose",
    "source_reference",
    "source_sha256"
  ],
  "properties": {
    "schema": {"const": "PRESENCE_AVALANCHE_ADMIN_INPUT_001"},
    "genesis_id": {"$ref": "#/$defs/id"},
    "locality_id": {"$ref": "#/$defs/id"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1024},
    "source_reference": {"$ref": "#/$defs/id"},
    "source_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
