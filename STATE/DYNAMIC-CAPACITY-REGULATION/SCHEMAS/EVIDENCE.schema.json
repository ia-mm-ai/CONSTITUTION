{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presence:core:dcr:evidence.schema:1",
  "title": "DCR bounded proof declaration",
  "x-status": "CANONICAL_SCHEMA",
  "x-source": {"refs": ["section.3.3", "section.18.1", "section.18.2", "section.18.3", "section.18.4", "reading.3", "reading.7"]},
  "x-rule-classification": "CORE_ENCODING_RULE",
  "type": "object",
  "required": ["kind", "id", "object", "method", "subject", "time", "basis", "result", "observation", "claim", "effect_ceiling", "evidence_available", "absence_model", "failure"],
  "additionalProperties": false,
  "properties": {
    "kind": {"type": "string", "const": "evidence"},
    "id": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "method": {"type": "string", "enum": ["SELF_REPORT", "BEHAVIOR", "OPTIONS", "SIGNATURE", "REPLAY", "MEASUREMENT", "LOCAL_JUDGMENT", "CONFORMANCE"]},
    "subject": {"$ref": "urn:presence:core:dcr:capacity.schema:1#/$defs/subject"},
    "time": {"$ref": "urn:presence:core:dcr:capacity.schema:1#/$defs/interval"},
    "basis": {"type": "string", "minLength": 1},
    "result": {"type": "string", "enum": ["SUPPORTED", "NOT_SUPPORTED", "UNKNOWN", "UNRESOLVED", "FAILED"]},
    "observation": {"type": "string", "enum": ["OCCURRENCE", "CARRIER", "RECORD", "REPRESENTATION", "INTERPRETATION"]},
    "claim": {
      "type": "object", "required": ["object", "subject", "time", "result"], "additionalProperties": false,
      "properties": {
        "object": {"type": "string", "minLength": 1},
        "subject": {"$ref": "urn:presence:core:dcr:capacity.schema:1#/$defs/subject"},
        "time": {"$ref": "urn:presence:core:dcr:capacity.schema:1#/$defs/instant"},
        "result": {"type": "string", "enum": ["SUPPORTED", "NOT_SUPPORTED", "UNKNOWN", "UNRESOLVED", "FAILED"]}
      }
    },
    "effect_ceiling": {"type": "string", "enum": ["ATTRIBUTABLE_CLAIM", "OBSERVED_TRACE", "EXACT_RELATIONAL_CONDITIONS", "ATTRIBUTION_RELATION", "TRACE_REPRODUCIBILITY", "MODEL_CORRELATE", "LOCAL_CLASSIFICATION", "TEST_SATISFACTION", "PRIVATE_CONDITION", "AUTHORITY", "UNIVERSAL_PERMISSION", "CURRENT_CAPACITY"]},
    "evidence_available": {"type": "boolean"},
    "absence_model": {"type": ["string", "null"], "minLength": 1},
    "failure": {"type": ["string", "null"], "minLength": 1}
  }
}
