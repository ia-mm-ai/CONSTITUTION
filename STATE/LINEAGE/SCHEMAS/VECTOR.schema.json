{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presence:core:lineage:vector:1",
  "title": "Exact normative vector suite",
  "x-status": "CANONICAL_SCHEMA",
  "x-rule-classification": "CORE_ENCODING_RULE",
  "x-source": {"refs": ["reading.7", "section.18.4"]},
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "status", "source", "cases"],
  "properties": {
    "kind": {"const": "normative_vector_suite"},
    "status": {"const": "NORMATIVE_VECTOR"},
    "source": {"$ref": "urn:presence:core:lineage:core:1#/$defs/source"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "schema", "input", "expected", "source", "forbidden_inference"],
        "properties": {
          "id": {"$ref": "urn:presence:core:lineage:core:1#/$defs/id"},
          "schema": {"type": "string", "pattern": "^urn:presence:core:[a-z0-9:-]+:1$"},
          "input": {
            "description": "Explicit test payload boundary: ANY JSON value is allowed here so invalid instances can be tested.",
            "type": ["object", "array", "string", "number", "boolean", "null"]
          },
          "expected": {
            "type": "object", "additionalProperties": false,
            "required": ["schema_valid", "semantic_result", "failure_codes"],
            "properties": {
              "schema_valid": {"type": "boolean"},
              "semantic_result": {"enum": ["NOT_EVALUATED", "CONSISTENT_AT_DECLARED_SCOPE", "INCONSISTENT"]},
              "failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}
            },
            "allOf": [
              {
                "if": {"properties": {"schema_valid": {"const": false}}},
                "then": {"properties": {"semantic_result": {"const": "NOT_EVALUATED"}, "failure_codes": {"const": ["SCHEMA_INVALID"]}}},
                "else": {"properties": {"semantic_result": {"enum": ["CONSISTENT_AT_DECLARED_SCOPE", "INCONSISTENT"]}, "failure_codes": {"not": {"contains": {"const": "SCHEMA_INVALID"}}}}}
              },
              {
                "if": {"properties": {"semantic_result": {"const": "CONSISTENT_AT_DECLARED_SCOPE"}}},
                "then": {"properties": {"failure_codes": {"maxItems": 0}}}
              },
              {
                "if": {"properties": {"semantic_result": {"const": "INCONSISTENT"}}},
                "then": {"properties": {"failure_codes": {"minItems": 1}}}
              }
            ]
          },
          "source": {
            "allOf": [
              {"$ref": "urn:presence:core:lineage:core:1#/$defs/source"},
              {"properties": {"refs": {"minItems": 1}}}
            ]
          },
          "forbidden_inference": {"$ref": "urn:presence:core:lineage:core:1#/$defs/text"}
        }
      }
    }
  }
}
