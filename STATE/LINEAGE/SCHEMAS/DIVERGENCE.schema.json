{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presence:core:lineage:divergence:1",
  "title": "LINEAGE visible incompatible streams",
  "x-status": "CANONICAL_SCHEMA",
  "x-rule-classification": "CORE_ENCODING_RULE",
  "x-source": {"refs": ["reading.3", "section.14.5", "section.16.6", "section.17.3", "section.17.8", "section.17.13", "section.17.15"]},
  "description": "Pairwise conflict record. More streams require further explicit records; no reconciliation propagates through a graph by inference.",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "id", "predecessor_relation", "scope", "boundary", "streams", "incompatibility", "classification", "identity_commitments", "treatment", "remaining_uncertainty"],
  "properties": {
    "kind": {"const": "divergence"}, "id": {"$ref": "#/$defs/text"},
    "predecessor_relation": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "basis_ref"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/support"}, "basis_ref": {"$ref": "#/$defs/text"}}
    },
    "scope": {"$ref": "#/$defs/text"}, "boundary": {"$ref": "#/$defs/text"},
    "streams": {
      "type": "object", "additionalProperties": false, "required": ["left", "right"],
      "properties": {"left": {"$ref": "#/$defs/stream"}, "right": {"$ref": "#/$defs/stream"}}
    },
    "incompatibility": {
      "type": "object", "additionalProperties": false, "required": ["left_state", "right_state", "description", "evidence_refs"],
      "properties": {
        "left_state": {"$ref": "#/$defs/text"}, "right_state": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "classification": {"enum": ["DIVERGENCE", "TRANSFORMATION", "UNRESOLVED"]},
    "identity_commitments": {
      "type": "object", "additionalProperties": false, "required": ["left", "right", "posture"],
      "properties": {
        "left": {"$ref": "#/$defs/references"}, "right": {"$ref": "#/$defs/references"},
        "posture": {"enum": ["SAME_AT_DECLARED_SCOPE", "DIFFERENT", "UNRESOLVED"]}
      }
    },
    "treatment": {
      "type": "object", "additionalProperties": false, "required": ["posture", "assigned_states", "reconciliation_basis"],
      "properties": {
        "posture": {"enum": ["VISIBLE_CONFLICT", "DISTINCT_CONTINUITIES", "RECONCILED"]},
        "assigned_states": {
          "type": "object", "additionalProperties": false, "required": ["left", "right"],
          "properties": {"left": {"$ref": "#/$defs/text"}, "right": {"$ref": "#/$defs/text"}}
        },
        "reconciliation_basis": {
          "type": "object", "additionalProperties": false, "required": ["id", "scope", "status", "evidence_refs"],
          "properties": {
            "id": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/support"}, "evidence_refs": {"$ref": "#/$defs/references"}
          }
        }
      }
    },
    "remaining_uncertainty": {"$ref": "#/$defs/references"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "support": {"enum": ["SUPPORTED", "UNKNOWN", "UNRESOLVED", "UNSUPPORTED", "REFUSED"]},
    "stream": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "locality", "state_ref", "state_basis", "history_refs", "retained_history_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "locality": {"$ref": "#/$defs/text"}, "state_ref": {"$ref": "#/$defs/text"}, "state_basis": {"$ref": "#/$defs/text"},
        "history_refs": {"$ref": "#/$defs/references"}, "retained_history_refs": {"$ref": "#/$defs/references"}
      }
    }
  }
}
