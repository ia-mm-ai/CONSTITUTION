{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:presence:core:csc:transition:1",
  "title":"Supported State transition representation",
  "x-status":"CANONICAL_SCHEMA",
  "x-source":{"refs":["section.14.1","section.14.2","section.16.7","section.17.7","section.17.8","section.17.9","section.17.14"]},
  "x-rule-classification":"CORE_ENCODING_RULE",
  "type":"object",
  "required":["kind","id","locality","scope","at","evidence","uncertainty","before","after","classification","target","basis","lineage","delta","correction","known_interruptions","recorded_interruptions"],
  "additionalProperties":false,
  "properties":{
    "kind":{"type":"string","const":"transition"},
    "id":{"$ref":"#/$defs/text"},"locality":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"},"at":{"$ref":"#/$defs/text"},
    "evidence":{"$ref":"#/$defs/evidence"},"uncertainty":{"$ref":"#/$defs/uncertainty"},
    "before":{"$ref":"#/$defs/state"},"after":{"$ref":"#/$defs/state"},
    "classification":{"type":"string","enum":["ADAPTATION","AMENDMENT","TRANSFORMATION","SUCCESSION","NEW_FORMATION","DIVERGENCE","DORMANCY","RESUMPTION","ENDING","UNRESOLVED"]},
    "target":{"type":"object","required":["id","layer"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/text"},"layer":{"type":"string","const":"STATE"}}},
    "basis":{"type":"object","required":["status","reference"],"additionalProperties":false,"properties":{"status":{"type":"string","enum":["SUPPORTED","UNKNOWN","DISPUTED"]},"reference":{"$ref":"#/$defs/nullable_text"}}},
    "lineage":{"type":"object","required":["predecessor","result","record","effect"],"additionalProperties":false,"properties":{"predecessor":{"$ref":"#/$defs/text"},"result":{"$ref":"#/$defs/text"},"record":{"$ref":"#/$defs/text"},"effect":{"type":"string","const":"STATE_RELATION_ONLY"}}},
    "delta":{"type":"object","required":["before","after","continues","ends","carries","predecessor_only","excluded","begins","unresolved"],"additionalProperties":false,"properties":{"before":{"$ref":"#/$defs/text"},"after":{"$ref":"#/$defs/text"},"continues":{"$ref":"#/$defs/strings"},"ends":{"$ref":"#/$defs/strings"},"carries":{"$ref":"#/$defs/strings"},"predecessor_only":{"$ref":"#/$defs/strings"},"excluded":{"$ref":"#/$defs/strings"},"begins":{"$ref":"#/$defs/strings"},"unresolved":{"$ref":"#/$defs/strings"}}},
    "correction":{"$ref":"#/$defs/nullable_text"},
    "known_interruptions":{"$ref":"#/$defs/strings"},"recorded_interruptions":{"$ref":"#/$defs/strings"}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":"\\S"},
    "nullable_text":{"type":["string","null"],"minLength":1,"pattern":"\\S"},
    "strings":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "uncertainty":{"type":"object","required":["status","matters"],"additionalProperties":false,"properties":{"status":{"type":"string","enum":["KNOWN_AT_SCOPE","UNKNOWN","UNRESOLVED"]},"matters":{"$ref":"#/$defs/strings"}}},
    "evidence":{"type":"object","required":["object","locality","scope","at","basis","method","result","effect_ceiling"],"additionalProperties":false,"properties":{"object":{"$ref":"#/$defs/text"},"locality":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"},"at":{"$ref":"#/$defs/text"},"basis":{"$ref":"#/$defs/text"},"method":{"type":"string","enum":["OBSERVATION","RECORD_COMPARISON","DEMONSTRATION","SELF_REPORT"]},"result":{"type":"string","enum":["SUPPORTED","UNSUPPORTED","UNKNOWN"]},"effect_ceiling":{"type":"string","const":"BOUNDED_REPRESENTATION_ONLY"}}},
    "state":{"type":"object","required":["id","locality","identity","applicable_law","at","posture","history","discontinuity"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/text"},"locality":{"$ref":"#/$defs/text"},"identity":{"$ref":"#/$defs/text"},"applicable_law":{"$ref":"#/$defs/text"},"at":{"$ref":"#/$defs/text"},"posture":{"type":"string","enum":["ACTIVE","DORMANT","ENDED","HELD","UNKNOWN","CONFLICTED"]},"history":{"$ref":"#/$defs/strings"},"discontinuity":{"$ref":"#/$defs/strings"}}}
  }
}
