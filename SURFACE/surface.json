  "operations": [
    {
      "id": "read",
      "handler": "serve.read_resource",
      "method": "GET",
      "route": "/api/read",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["resource"],
        "properties": {"resource": {"type": "string", "minLength": 1, "maxLength": 512}}
      },
      "output": {"representation": "exact_resource_bytes", "media_type_from": "index.resources[].media_type"},
      "scope": "Only a resource ref listed in this edition; no caller-supplied filesystem path."
    },
    {
      "id": "resolve",
      "handler": "serve.resolve_reference",
      "method": "GET",
      "route": "/api/resolve",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["ref"],
        "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 512}}
      },
      "output": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "ref", "path", "pointer"],
        "properties": {
          "revision": {"type": "string"}, "ref": {"type": "string"},
          "path": {"type": "string"}, "pointer": {"type": "string"}
        }
      },
      "scope": "Exact listed resource or bound Source ref, returned as an edition path and JSON Pointer; no remote resolution."
    },
    {
      "id": "check",
      "handler": "serve.check_resource",
      "method": "GET",
      "route": "/api/check",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["resource"],
        "properties": {"resource": {"type": "string", "minLength": 1, "maxLength": 512}}
      },
      "output": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "resource", "sha256", "byte_length", "result", "conformance", "effect_ceiling"],
        "properties": {
          "revision": {"type": "string"}, "resource": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0},
          "result": {"enum": ["MATCH", "MISMATCH"]},
          "conformance": {"const": "NOT_EVALUATED"},
          "effect_ceiling": {"type": "string"}
        }
      },
      "scope": "Exact served bytes against this edition's binding; not evaluation of arbitrary submitted records or constitutional conformance."
    }
  ]
