{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-reality-body.consequence-index.v0.1",
  "type": "object",
  "required": [
    "schema",
    "body_id",
    "represented_currentness_revision",
    "records",
    "record_count",
    "explicit_non_effects"
  ],
  "properties": {
    "schema": {
      "const": "local-reality-body.consequence-index.v0.1"
    },
    "body_id": {
      "const": "RM-LOCAL-REALITY-BODY-001"
    },
    "represented_currentness_revision": {
      "const": 7
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "target",
          "actual_local_change",
          "time_or_interval",
          "source",
          "attribution_basis",
          "related_occurrence_or_impact",
          "legitimacy_posture",
          "uncertainty",
          "predecessor",
          "currentness_effect"
        ],
        "additionalProperties": true
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "explicit_non_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
