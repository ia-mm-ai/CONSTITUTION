{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-reality-body.regulation-index.v0.1",
  "type": "object",
  "required": [
    "schema",
    "body_id",
    "represented_currentness_revision",
    "records",
    "record_count",
    "mechanism_present",
    "explicit_non_effects"
  ],
  "properties": {
    "schema": {
      "const": "local-reality-body.regulation-index.v0.1"
    },
    "body_id": {
      "const": "RM-LOCAL-REALITY-BODY-001"
    },
    "represented_currentness_revision": {
      "const": 8
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "carrier",
          "sha256",
          "matter_record_id",
          "local_record_posture",
          "progression_posture",
          "locus_assessment",
          "law_compatibility_assessment",
          "evidence_posture",
          "authority_presentation"
        ],
        "additionalProperties": true
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "const": 1
    },
    "mechanism_present": {
      "const": false
    },
    "explicit_non_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
