{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-reality-body.regulation-index.v0.1",
  "type": "object",
  "required": ["schema", "body_id", "represented_currentness_revision", "records", "record_count", "mechanism_present", "explicit_non_effects"],
  "properties": {
    "schema": {"const": "local-reality-body.regulation-index.v0.1"},
    "body_id": {"const": "RM-LOCAL-REALITY-BODY-001"},
    "represented_currentness_revision": {"const": 5},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "matter_record_id", "source", "local_target", "basis", "originating_surface", "recorded_at", "predecessor", "uncertainty", "local_record_posture", "progression_posture", "locus_assessment", "law_compatibility_assessment", "evidence_posture", "authority_presentation", "explicit_non_effects"],
        "properties": {
          "local_record_posture": {"enum": ["RECEIVED_REFERENCE_ONLY", "ADMITTED_BODY_LOCAL_MATTER", "UNRESOLVED"]},
          "progression_posture": {"enum": ["HELD", "NON_PROGRESSING", "READY_FOR_AUTHORITY_CONSIDERATION", "RELEASED", "UNRESOLVED"]},
          "locus_assessment": {"enum": ["UNASSESSED", "WITHIN_SUPPORTED_LOCUS", "OUTSIDE_SUPPORTED_LOCUS", "UNRESOLVED"]},
          "law_compatibility_assessment": {"enum": ["UNASSESSED", "NO_CONFLICT_IDENTIFIED", "INCOMPATIBLE_WITH_APPLICABLE_LAW", "UNRESOLVED"]},
          "evidence_posture": {"enum": ["NONE_ADMITTED", "PARTIAL", "SUFFICIENT_FOR_STATED_ASSESSMENT", "CONFLICTING", "UNRESOLVED"]},
          "authority_presentation": {"enum": ["NOT_PRESENTED", "PRESENTED", "WITHDRAWN", "UNRESOLVED"]}
        },
        "additionalProperties": true
      }
    },
    "record_count": {"type": "integer", "minimum": 0},
    "mechanism_present": {"const": false},
    "explicit_non_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
